# ==============================================================================
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Renomeie para .env e preencha com suas credenciais locais
# NUNCA envie o arquivo .env preenchido para o GitHub!
# ==============================================================================

# Autenticação Plataforma Financeira F360
F360_EMAIL=seu_email@empresa.com.br
F360_PASSWORD=sua_senha_segura
USUARIO=seu_usuario_f360
SENHA=sua_senha_f360

# Autenticação ERP Cigam
CIGAM_ACESSO=https://app.cigamgestor.com.br/login
CIGAM_USER=seu_usuario_cigam
CIGAM_SENHA=sua_senha_cigam

# E-mail & Triagem IMAP / Disparo SMTP
EMAIL_USER=sua_conta@gmail.com
EMAIL_PASS=sua_senha_de_app_16_digitos
IMAP_SERVER=imap.gmail.com
MEU_EMAIL=sua_conta@gmail.com
MINHA_SENHA=sua_senha_de_app_16_digitos

# Google Sheets & Cloud Service Account
GOOGLE_SERVICE_ACCOUNT_JSON=chave_google.json
SPREADSHEET_ID_BOLETOS=ID_DA_PLANILHA_GOOGLE_SHEETS
URL_LICENCA=https://docs.google.com/spreadsheets/d/SEU_PAINEL_ID/pub?output=csv
